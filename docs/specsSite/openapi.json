	"components": {
		"schemas": {
			"AuthEmailRequest": {
				"properties": {
					"email": {
						"type": "string",
						"format": "email",
						"title": "Email"
					}
				},
				"type": "object",
				"required": [
					"email"
				],
				"title": "AuthEmailRequest"
			},
			"AuthVerifyRequest": {
				"properties": {
					"email": {
						"type": "string",
						"format": "email",
						"title": "Email"
					},
					"code": {
						"type": "string",
						"maxLength": 6,
						"minLength": 6,
						"title": "Code"
					}
				},
				"type": "object",
				"required": [
					"email",
					"code"
				],
				"title": "AuthVerifyRequest"
			},
			"AuthVerifyResponse": {
				"properties": {
					"access_token": {
						"type": "string",
						"title": "Access Token"
					},
					"refresh_token": {
						"type": "string",
						"title": "Refresh Token"
					},
					"user": {
						"$ref": "#/components/schemas/UserResponse"
					}
				},
				"type": "object",
				"required": [
					"access_token",
					"refresh_token",
					"user"
				],
				"title": "AuthVerifyResponse"
			},
			"GameCreateRequest": {
				"properties": {
					"board_size": {
						"type": "integer",
						"enum": [
							3,
							5,
							10,
							30
						],
						"title": "Board Size"
					},
					"win_sequence": {
						"type": "integer",
						"enum": [
							3,
							4,
							5
						],
						"title": "Win Sequence"
					},
					"game_mode": {
						"type": "string",
						"enum": [
							"computer",
							"friend"
						],
						"title": "Game Mode"
					},
					"model_id": {
						"anyOf": [
							{
								"type": "string",
								"format": "uuid"
							},
							{
								"type": "null"
							}
						],
						"title": "Model Id"
					},
					"difficulty": {
						"anyOf": [
							{
								"type": "string",
								"enum": [
									"easy",
									"medium",
									"hard"
								]
							},
							{
								"type": "null"
							}
						],
						"title": "Difficulty"
					},
					"player_x_name": {
						"type": "string",
						"title": "Player X Name",
						"default": "Player X"
					},
					"player_o_name": {
						"type": "string",
						"title": "Player O Name",
						"default": "Player O"
					}
				},
				"type": "object",
				"required": [
					"board_size",
					"win_sequence",
					"game_mode"
				],
				"title": "GameCreateRequest"
			},
			"GameCreateResponse": {
				"properties": {
					"session_id": {
						"type": "string",
						"format": "uuid",
						"title": "Session Id"
					}
				},
				"type": "object",
				"required": [
					"session_id"
				],
				"title": "GameCreateResponse"
			},
			"GameListItem": {
				"properties": {
					"sessionId": {
						"type": "string",
						"format": "uuid",
						"title": "Sessionid"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time",
						"title": "Createdat"
					},
					"opponentName": {
						"type": "string",
						"title": "Opponentname"
					},
					"opponentType": {
						"type": "string",
						"enum": [
							"LLM",
							"friend"
						],
						"title": "Opponenttype"
					},
					"boardSize": {
						"type": "integer",
						"title": "Boardsize"
					},
					"difficulty": {
						"anyOf": [
							{
								"type": "string",
								"enum": [
									"easy",
									"medium",
									"hard"
								]
							},
							{
								"type": "null"
							}
						],
						"title": "Difficulty"
					},
					"firstMove": {
						"type": "string",
						"enum": [
							"player",
							"ai",
							"friend"
						],
						"title": "Firstmove"
					},
					"currentMove": {
						"anyOf": [
							{
								"type": "string",
								"enum": [
									"player",
									"ai",
									"friend"
								]
							},
